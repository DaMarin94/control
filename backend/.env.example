# Base de datos PostgreSQL
DATABASE_URL=

# Secret compartido entre frontend y backend para firmar/validar el JWT (HS256)
JWT_SECRET=

# Puerto en que corre el servidor (default: 3001)
PORT=

# Google OAuth — solo necesario si se usa el endpoint POST /auth/google
# Obtener en https://console.cloud.google.com/
GOOGLE_CLIENT_ID=

# Origin del frontend permitido para CORS (default: http://localhost:3000)
CORS_ORIGIN=
