# Base de datos PostgreSQL
DATABASE_URL=

# Secret compartido entre frontend y backend para firmar/validar el JWT (HS256)
JWT_SECRET=

# Puerto en que corre el servidor (default: 3001)
PORT=

# Google OAuth — solo necesario si se usa el endpoint POST /auth/google
# Obtener en https://console.cloud.google.com/
GOOGLE_CLIENT_ID=

# Origin del frontend permitido para CORS (default: http://localhost:3000)
CORS_ORIGIN=

# Secret de operación para el endpoint POST /settings/reference-rates/sync (P7 — cron/trigger).
# NO es el JWT de usuario. Debe ser un valor aleatorio de al menos 32 caracteres
# (recomendado: 64 caracteres hex = 256 bits). Nunca compartir ni loggear.
# Generar con: openssl rand -hex 32
CRON_SECRET=
