// schema.prisma — Fuente de verdad del modelo de datos
// Generador y datasource

generator client {
  provider = "prisma-client-js"
}

// En Prisma 7 la URL de conexión va en prisma.config.ts (defineConfig),
// no en el datasource del schema. Ver prisma.config.ts en la raíz del backend.
datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum MovementType {
  EXPENSE
  INCOME
}

enum CategoryScope {
  BOTH
  EXPENSE
  INCOME
}

// Frecuencia de aparición de un movimiento fijo (P2 — Fase 1.1.1).
// Set cerrado: no hay frecuencias libres ni custom.
// La frecuencia está anclada al startMonth del fijo:
//   - MONTHLY (step 1):   aparece cada mes a partir de startMonth
//   - BIMONTHLY (step 2): cada 2 meses (ej: startMonth=marzo → mar, may, jul...)
//   - QUARTERLY (step 3): cada 3 meses
//   - BIANNUAL (step 6):  cada 6 meses
//   - ANNUAL (step 12):   una vez por año
// Back-compat: todos los fijos existentes quedan con MONTHLY (default de migración).
enum RecurringFrequency {
  MONTHLY
  BIMONTHLY
  QUARTERLY
  BIANNUAL
  ANNUAL
}

// Operadores de la fórmula de un movimiento calculado (Fase 1.1.7).
// El monto del calculado es: sign × round(operator(sourceAmount, operand))
//   ADD:  sourceAmount + operand           (operand en centavos)
//   SUB:  sourceAmount - operand           (operand en centavos)
//   MUL:  sourceAmount × operand           (operand es factor crudo, ej. 1.5)
//   DIV:  sourceAmount ÷ operand           (operand es divisor; ≠ 0)
//   PCT:  sourceAmount × operand ÷ 100     (operand es porcentaje; ≠ 0)
enum FormulaOperator {
  ADD
  SUB
  MUL
  DIV
  PCT
}

// ---------------------------------------------------------------------------
// User
// ---------------------------------------------------------------------------

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  image        String?
  // Nullable: cuentas solo-Google no tienen contraseña
  passwordHash String?
  // Zona horaria IANA "de casa" del usuario, usada como default al crear movimientos
  timezone     String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relaciones — onDelete: Cascade: si se borra el usuario, todo lo suyo desaparece
  categories        Category[]
  transactions      Transaction[]
  recurrings        Recurring[]
  installmentGroups InstallmentGroup[]
  preferences       UserPreferences?
}

// ---------------------------------------------------------------------------
// UserPreferences (Fase 1.1.0 — cimiento de preferencias de usuario)
// ---------------------------------------------------------------------------

// Una fila por usuario. El contenido es un blob JSON abierto (Json type de Prisma).
// Default {} — arranca vacío, cada fase consumidora agrega sus claves.
// onDelete: Cascade — se elimina automáticamente si se borra el usuario.
model UserPreferences {
  id     String @id @default(cuid())
  userId String @unique

  // Blob JSON de preferencias. Arranca como {} y se muta vía PUT /preferences.
  // No tiene claves fijas: cada fase consumidora agrega las suyas sin migración.
  data Json @default("{}")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------------
// Category
// ---------------------------------------------------------------------------

// NOTA sobre unicidad de nombre:
// NO hay @@unique([userId, name]) a propósito.
// La unicidad de nombre de categoría activa se valida en lógica de aplicación
// (comparación normalizada: trim + insensible a mayúsculas + insensible a acentos),
// porque la normalización unicode y el flujo "crear-o-reactivar" (proponer reactivar
// una categoría con soft-delete si el nombre normalizado coincide) no son expresables
// en un constraint de DB estándar. Ver RF-CAT-002 y RN-014.
model Category {
  id     String        @id @default(cuid())
  userId String
  name   String
  scope  CategoryScope
  // color: string hex libre en Fase 1; el pool de colores y asignación automática
  // van en Fase 3. Por ahora se almacena el valor elegido directamente.
  color String

  // Soft delete: deletedAt != null → categoría eliminada (no aparece en selectores,
  // pero sus FK en Transaction/Recurring/InstallmentGroup siguen siendo válidas)
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // onDelete: Restrict en todas las FKs de categoryId:
  // impide borrar físicamente una categoría mientras existan movimientos que la referencian.
  // Las categorías usan soft delete, por lo que este caso nunca debería ocurrir en
  // la práctica, pero el Restrict lo garantiza a nivel DB.
  transactions      Transaction[]
  recurrings        Recurring[]
  installmentGroups InstallmentGroup[]

  @@index([userId])
}

// ---------------------------------------------------------------------------
// Transaction (movimiento único)
// ---------------------------------------------------------------------------

// Hard delete (RF-MU-003): borrado permanente — NO lleva deletedAt.
model Transaction {
  id          String       @id @default(cuid())
  userId      String
  categoryId  String
  type        MovementType
  // Monto en centavos para evitar errores de punto flotante (RN-002)
  amountCents Int
  description String?

  // occurredAt: instante UTC del movimiento (momento elegido por el usuario)
  // @db.Timestamptz: guarda con zona en Postgres para cálculos correctos con AT TIME ZONE
  occurredAt DateTime @db.Timestamptz
  // timezone: nombre IANA de la zona en que ocurrió el gasto (no el offset crudo)
  // Se guarda junto al registro para poder reconstruir la hora local original
  // y para bucketear por mes en la zona correcta (ver docs/technical.md — Fechas)
  timezone   String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  // Índice compuesto para la consulta de movimientos por mes (filtra por usuario + ordena por fecha)
  @@index([userId, occurredAt])
}

// ---------------------------------------------------------------------------
// Recurring (movimiento fijo)
// ---------------------------------------------------------------------------

model Recurring {
  id          String       @id @default(cuid())
  userId      String
  categoryId  String
  type        MovementType
  amountCents Int
  description String?

  // startMonth: mes desde el que aparece el fijo, formato "YYYY-MM"
  startMonth String
  // deletedFrom: mes desde el cual deja de aparecer (exclusivo); null = activo indefinidamente
  // Formato "YYYY-MM"
  deletedFrom String?

  // frequency: periodicidad del fijo (P2 — Fase 1.1.1).
  // Default MONTHLY para back-compat con todos los fijos anteriores a 1.1.1.
  // La frecuencia está anclada al startMonth: monthDiff(startMonth, mes) % step === 0
  // determina si el fijo aparece en ese mes.
  frequency RecurringFrequency @default(MONTHLY)

  // ---------------------------------------------------------------------------
  // Identidad de cadena estable (Fase 1.1.7)
  // chainId: identificador que persiste a través de todos los splits del fijo.
  // Cuando PATCH hace un split (cierra R1 y abre R2), R2 hereda el chainId de R1.
  // Así el vínculo de los calculados al origen no se rompe al editar el origen.
  // Asignado en creación (cuid()) y nunca modificado después.
  // No es un FK — es un tag compartido por la cadena lógica.
  // ---------------------------------------------------------------------------
  chainId String @default(cuid())

  // ---------------------------------------------------------------------------
  // Movimiento calculado (Fase 1.1.7) — campos opcionales:
  // Solo presentes si esta fila ES un calculado (sourceChainId != null).
  // Un fijo normal deja todos estos campos en null.
  // ---------------------------------------------------------------------------

  // sourceChainId: chainId del fijo de origen. Nunca puede ser el propio chainId
  // (sin encadenamiento). FK lógica — no hay FK de DB (la cadena puede tener
  // varias filas con distintos ids).
  sourceChainId String?

  // formulaOperator: operador de la fórmula (ADD/SUB/MUL/DIV/PCT).
  formulaOperator FormulaOperator?

  // formulaOperand: operando de la fórmula.
  // Para ADD/SUB: centavos (Int × 100). Para MUL/DIV: factor crudo × 1000000 (6 decimales).
  // Para PCT: porcentaje × 100 (ej. 10% → 1000, 1.5% → 150).
  // Se almacena como Int para precisión entera.
  formulaOperand Int?

  // formulaSign: signo del resultado. 1 = positivo, -1 = negativo.
  formulaSign Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  // Meses salteados (P1 — Fase 1.1.1): cada fila representa una aparición anulada.
  // onDelete: Cascade: si se borra el fijo, sus skips desaparecen.
  skips RecurringSkip[]

  @@index([userId])
  @@index([chainId])
  @@index([sourceChainId])
}

// ---------------------------------------------------------------------------
// RecurringSkip (meses salteados por fijo — P1, Fase 1.1.1)
// ---------------------------------------------------------------------------

// Modela "una aparición del fijo está anulada para ese mes puntual".
// Es reversible: la acción es un toggle (anular / des-anular).
// El mes anulado SE SIGUE MOSTRANDO en /movements marcado con skipped=true.
// No suma a los totales del mes (se excluye del cálculo).
// Solo tiene sentido para meses en los que el fijo efectivamente aparece según su frecuencia.
model RecurringSkip {
  id          String @id @default(cuid())
  recurringId String
  // month: mes anulado en formato "YYYY-MM"
  month       String

  createdAt DateTime @default(now())

  recurring Recurring @relation(fields: [recurringId], references: [id], onDelete: Cascade)

  // Restricción: solo puede haber un skip por (fijo, mes)
  @@unique([recurringId, month])
  @@index([recurringId])
}

// ---------------------------------------------------------------------------
// InstallmentGroup (grupo de cuotas)
// ---------------------------------------------------------------------------

model InstallmentGroup {
  id                String       @id @default(cuid())
  userId            String
  categoryId        String
  type              MovementType
  // amountCents: monto POR CUOTA (no el total de la compra)
  amountCents       Int
  totalInstallments Int
  description       String?

  // startMonth: mes de la primera cuota, formato "YYYY-MM"
  startMonth String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@index([userId])
}
