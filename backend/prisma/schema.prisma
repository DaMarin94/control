// schema.prisma — Fuente de verdad del modelo de datos
// Generador y datasource

generator client {
  provider = "prisma-client-js"
}

// En Prisma 7 la URL de conexión va en prisma.config.ts (defineConfig),
// no en el datasource del schema. Ver prisma.config.ts en la raíz del backend.
datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum MovementType {
  EXPENSE
  INCOME
}

// Moneda de un movimiento (Fase 1.2.3 — Multi-moneda ARS/USD; Fase 1.2.4 — +EUR +BRL).
// Set curado de 4 monedas: no hay alta de monedas arbitrarias.
// Pivote de conversión: USD (toda cotización es "unidades de esta moneda por 1 USD").
enum Currency {
  ARS
  USD
  EUR
  BRL
}

enum CategoryScope {
  BOTH
  EXPENSE
  INCOME
}

// Operadores de la fórmula de un movimiento calculado (Fase 1.1.7).
// El monto del calculado es: sign × round(operator(sourceAmount, operand))
//   ADD:  sourceAmount + operand           (operand en centavos)
//   SUB:  sourceAmount - operand           (operand en centavos)
//   MUL:  sourceAmount × operand           (operand es factor crudo, ej. 1.5)
//   DIV:  sourceAmount ÷ operand           (operand es divisor; ≠ 0)
//   PCT:  sourceAmount × operand ÷ 100     (operand es porcentaje; ≠ 0)
enum FormulaOperator {
  ADD
  SUB
  MUL
  DIV
  PCT
}

// Historial de cambios (Módulo 3.14 — RF-HIST-001..006).
// targetKind mapea 1:1 a la tabla de almacenamiento del movimiento (NO al tipo
// "conceptual" del movimiento): Transaction -> UNICO, Recurring -> FIJO
// (incluye fijos normales Y calculados de cualquier origen, porque estructuralmente
// son filas Recurring), InstallmentGroup -> CUOTA.
enum HistoryTargetKind {
  UNICO
  FIJO
  CUOTA
}

enum HistoryAction {
  EDIT
  DELETE
}

// ---------------------------------------------------------------------------
// ReferenceRate (tabla de cotizaciones de referencia por mes — Fase 1.2.4)
// ---------------------------------------------------------------------------

// Cotización de referencia mensual, global (sin userId).
// Sirve de valor por defecto/pre-carga para la cotización de los movimientos.
// No es un FK: el movimiento copia el valor al crearse; el campo exchangeRate
// del movimiento sigue siendo editable y es el que manda en la conversión.
//
// Semántica del campo rate:
//   rate = unidades de ESTA moneda por 1 USD (pivote USD).
//   - Para ARS: cuántos ARS vale 1 USD (ej: 1432)
//   - Para EUR: cuántos EUR vale 1 USD (ej: 0.865)
//   - Para BRL: cuántos BRL vale 1 USD (ej: 5.11)
//   - USD no necesita fila (implícito: rate = 1). Decisión: NO guardar filas USD=1;
//     el service las trata implícitamente. Esto evita ruido en la tabla y aclara
//     que el pivote es USD (rate_USD = 1 siempre, por definición).
//
// El cruce entre dos monedas no-USD se deriva: para convertir X de moneda A a B,
// se pasa por USD: X_USD = X_A / rate_A; X_B = X_USD * rate_B.
//
// yearMonth: mes de vigencia en formato "YYYY-MM" (igual que startMonth/deletedFrom).
// Clave única: (currency, yearMonth) — una fila por moneda por mes.
model ReferenceRate {
  id        String   @id @default(cuid())
  currency  Currency
  yearMonth String   // "YYYY-MM"
  // Cotización: unidades de esta moneda por 1 USD.
  // Tipo Decimal para precisión; no en centavos (igual que exchangeRate en movimientos).
  rate      Decimal  @db.Decimal(18, 6)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([currency, yearMonth])
  @@index([currency, yearMonth])
}

// ---------------------------------------------------------------------------
// User
// ---------------------------------------------------------------------------

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  image        String?
  // Nullable: cuentas solo-Google no tienen contraseña
  passwordHash String?
  // Zona horaria IANA "de casa" del usuario, usada como default al crear movimientos
  timezone     String

  // Multi-moneda (Fase 1.2.3): moneda por defecto del usuario y última cotización usada.
  // defaultCurrency: la moneda en que el usuario opera habitualmente (default ARS).
  // lastExchangeRate: última cotización ARS/USD ingresada; se actualiza al guardar
  //   cualquier movimiento con exchangeRate. Se usa para pre-cargar el campo cotización
  //   en el formulario. Null hasta que el usuario ingrese su primera cotización.
  defaultCurrency  Currency  @default(ARS)
  lastExchangeRate Decimal?  @db.Decimal(18, 6)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relaciones — onDelete: Cascade: si se borra el usuario, todo lo suyo desaparece
  categories        Category[]
  paymentMethods    PaymentMethod[]
  transactions      Transaction[]
  recurrings        Recurring[]
  installmentGroups InstallmentGroup[]
  preferences       UserPreferences?
  historyEntries    HistoryEntry[]
  simulations       Simulation[]
}

// ---------------------------------------------------------------------------
// HistoryEntry (Historial de cambios — Módulo 3.14, RF-HIST-001..006)
// ---------------------------------------------------------------------------

// Una fila por edición o eliminación de un movimiento (RF-HIST-001). Registro de
// corto plazo, NO un log de auditoría: se purga por cantidad (5 por movimiento,
// RF-HIST-005) o antigüedad (31 días) — lo que ocurra primero.
//
// targetId es la CLAVE ESTABLE de agrupación por movimiento (RN-024):
//   UNICO -> Transaction.id
//   FIJO  -> Recurring.chainId (fijo normal O calculado, de cualquier origen —
//            sobrevive a los splits de edición, a diferencia del id de fila)
//   CUOTA -> InstallmentGroup.id
//
// snapshot: estado previo completo (antes de la mutación), suficiente para
// restaurar por completo al deshacer (RF-HIST-003). Shape por targetKind/action
// documentado en backend/src/history/history.types.ts (no modelado en Prisma
// porque cada combinación targetKind×action tiene una forma distinta).
model HistoryEntry {
  id         String            @id @default(cuid())
  userId     String
  targetKind HistoryTargetKind
  targetId   String
  action     HistoryAction
  snapshot   Json
  createdAt  DateTime          @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Listar por usuario, orden cronológico descendente (GET /history)
  @@index([userId, createdAt])
  // Resolver el stack LIFO de un movimiento (undo, retención por cantidad)
  @@index([userId, targetKind, targetId, createdAt])
  // Barrer por antigüedad (purga de los 31 días — RF-HIST-005)
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// UserPreferences (Fase 1.1.0 — cimiento de preferencias de usuario)
// ---------------------------------------------------------------------------

// Una fila por usuario. El contenido es un blob JSON abierto (Json type de Prisma).
// Default {} — arranca vacío, cada fase consumidora agrega sus claves.
// onDelete: Cascade — se elimina automáticamente si se borra el usuario.
model UserPreferences {
  id     String @id @default(cuid())
  userId String @unique

  // Blob JSON de preferencias. Arranca como {} y se muta vía PUT /preferences.
  // No tiene claves fijas: cada fase consumidora agrega las suyas sin migración.
  data Json @default("{}")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------------
// Category
// ---------------------------------------------------------------------------

// NOTA sobre unicidad de nombre:
// NO hay @@unique([userId, name]) a propósito.
// La unicidad de nombre de categoría activa se valida en lógica de aplicación
// (comparación normalizada: trim + insensible a mayúsculas + insensible a acentos),
// porque la normalización unicode y el flujo "crear-o-reactivar" (proponer reactivar
// una categoría con soft-delete si el nombre normalizado coincide) no son expresables
// en un constraint de DB estándar. Ver RF-CAT-002 y RN-014.
model Category {
  id     String        @id @default(cuid())
  userId String
  name   String
  scope  CategoryScope
  // color: string hex libre en Fase 1; el pool de colores y asignación automática
  // van en Fase 3. Por ahora se almacena el valor elegido directamente.
  color String

  // Soft delete: deletedAt != null → categoría eliminada (no aparece en selectores,
  // pero sus FK en Transaction/Recurring/InstallmentGroup siguen siendo válidas)
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // onDelete: Restrict en todas las FKs de categoryId:
  // impide borrar físicamente una categoría mientras existan movimientos que la referencian.
  // Las categorías usan soft delete, por lo que este caso nunca debería ocurrir en
  // la práctica, pero el Restrict lo garantiza a nivel DB.
  transactions      Transaction[]
  recurrings        Recurring[]
  installmentGroups InstallmentGroup[]
  simulations       Simulation[]

  @@index([userId])
}

// ---------------------------------------------------------------------------
// PaymentMethod (método de pago — P4)
// ---------------------------------------------------------------------------

// Espejo de Category: propio del usuario, soft delete, unicidad de nombre
// app-level (mismo motivo que Category — ver nota arriba de ese modelo).
// Diferencias de modelado respecto de Category:
//   - identidad visual: icon (string, allowlist en código), SIN campo color.
//   - type: string con allowlist en código (CREDIT/DEBIT/CASH), NO enum de Prisma,
//     para sumar tipos futuros sin migración (mismo criterio que CurrencyQuote.variant).
//   - campos condicionales por tipo, nullable: closingDay/paymentDay (solo CREDIT).
//     Al cambiar de tipo el service limpia los que no aplican.
// NOTA: autoDebit NO vive acá — es un atributo del MOVIMIENTO (Transaction/Recurring/
// InstallmentGroup), no del método. Ver esos modelos.
// Metadato: no entra a ningún cálculo de dinero (RN-021).
model PaymentMethod {
  id     String @id @default(cuid())
  userId String
  name   String
  // type: allowlist en código (CREDIT | DEBIT | CASH). String, no enum (RN-021).
  type   String

  // Campos condicionales por tipo (nullable — solo aplican a CREDIT):
  closingDay Int? // solo CREDIT. Día del mes 1-31, informativo (RN-021)
  paymentDay Int? // solo CREDIT. Día del mes 1-31, informativo (RN-021)

  // icon: allowlist en código, default/fallback "card". Única identidad visual (sin color).
  icon String @default("card")

  // Soft delete: deletedAt != null → método eliminado (no aparece en selectores,
  // pero sus FK en Transaction/Recurring/InstallmentGroup siguen siendo válidas)
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // onDelete: Restrict en todas las FKs de paymentMethodId (espejo de categoryId):
  // impide borrar físicamente un método mientras existan movimientos que lo referencian.
  transactions      Transaction[]
  recurrings        Recurring[]
  installmentGroups InstallmentGroup[]

  @@index([userId])
}

// ---------------------------------------------------------------------------
// Transaction (movimiento único)
// ---------------------------------------------------------------------------

// Borrado lógico (RF-HIST-006): ver deletedAt más abajo — reversible desde /historial
// mientras la entrada esté vigente, y purgado físicamente recién al expirar (reaper).
model Transaction {
  id          String       @id @default(cuid())
  userId      String
  categoryId  String
  // paymentMethodId: método de pago asociado, opcional (RF-PM-006). onDelete: Restrict
  // (espejo de categoryId): un método con movimientos no se hard-deletea (soft delete).
  paymentMethodId String?
  type        MovementType
  // Monto en centavos para evitar errores de punto flotante (RN-002)
  amountCents Int
  description String?

  // occurredAt: instante UTC del movimiento (momento elegido por el usuario)
  // @db.Timestamptz: guarda con zona en Postgres para cálculos correctos con AT TIME ZONE
  occurredAt DateTime @db.Timestamptz
  // timezone: nombre IANA de la zona en que ocurrió el gasto (no el offset crudo)
  // Se guarda junto al registro para poder reconstruir la hora local original
  // y para bucketear por mes en la zona correcta (ver docs/technical.md — Fechas)
  timezone   String

  // Multi-moneda (Fase 1.2.3 / 1.2.4):
  // currency: moneda original del movimiento. Default ARS (back-compat).
  // exchangeRate: cotización al momento del movimiento.
  //   Semántica: unidades de anchorCurrency por 1 unidad de currency.
  //   Default 1.0 para back-compat (movimientos ARS con anchorCurrency ARS).
  // anchorCurrency: moneda default del usuario AL MOMENTO de guardar/editar el movimiento.
  //   Es la moneda de referencia del exchangeRate guardado.
  //   Default ARS para back-compat (todos los movimientos preexistentes fueron creados
  //   cuando ARS era la única default posible).
  //   Permite re-rutar la conversión si el usuario cambia su defaultCurrency:
  //     amount_display = amountCents × exchangeRate × rate_display / rate_anchor
  //   donde rate_* son filas de ReferenceRate del mes del movimiento.
  currency        Currency @default(ARS)
  exchangeRate    Decimal  @default(1) @db.Decimal(18, 6)
  anchorCurrency  Currency @default(ARS)

  // Anulación (skip) de un único (P3 — Fase 1.1.1.ext).
  // El único es una sola fila: no hay tabla de meses (a diferencia de fijos/cuotas),
  // el skip es directamente un flag booleano en la fila. Reversible (toggle).
  // Anulado: se SIGUE MOSTRANDO en /movements marcado con skipped=true, pero no suma
  // a totales del mes ni a ningún reporte.
  skipped Boolean @default(false)

  // autoDebit: débito automático (P4 — corrección de alcance). Atributo del MOVIMIENTO,
  // no del método de pago. Solo relevante cuando paymentMethodId apunta a un método de
  // tipo DEBIT; en cualquier otro caso queda null (el service lo fuerza — ver
  // PaymentMethodValidatorService.resolveAutoDebit). Nullable, default null.
  autoDebit Boolean?

  // Borrado lógico (RF-HIST-006): != null → el único fue eliminado por el usuario.
  // Deja de aparecer en TODA la app (listados, totales, reportes) salvo /historial,
  // desde donde es reversible (RF-HIST-003) mientras su entrada de historial esté
  // vigente. El borrado físico ocurre recién al purgarse esa entrada (RF-HIST-005).
  // Ortogonal a cualquier otro campo de estado del movimiento (ninguno existe en
  // Transaction, pero ver Recurring.deletedFrom para el caso análogo a evitar confundir).
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  category      Category       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  paymentMethod PaymentMethod? @relation(fields: [paymentMethodId], references: [id], onDelete: Restrict)

  // Calculados derivados de este Transaction (Fase 1.1.7.ext).
  // onDelete: Cascade en la FK del lado Recurring: solo se ejecuta en el borrado FÍSICO
  // definitivo (reaper de RF-HIST-005). Mientras el único está soft-deleted, la cascada
  // a sus calculados es lógica y se aplica en RecurringService (RN-024/026).
  calculados Recurring[]

  // Índice compuesto para la consulta de movimientos por mes (filtra por usuario + ordena por fecha)
  @@index([userId, occurredAt])
}

// ---------------------------------------------------------------------------
// Recurring (movimiento fijo)
// ---------------------------------------------------------------------------

model Recurring {
  id          String       @id @default(cuid())
  userId      String
  categoryId  String
  // paymentMethodId: método de pago asociado, opcional (RF-PM-006). Solo relevante para
  // fijos NORMALES: un calculado NUNCA lo persiste (hereda el método del origen al vuelo,
  // igual que currency/exchangeRate — no se setea en la creación/edición de calculados).
  paymentMethodId String?
  type        MovementType
  amountCents Int
  description String?

  // startMonth: mes desde el que aparece el fijo, formato "YYYY-MM"
  startMonth String
  // deletedFrom: mes desde el cual deja de aparecer (exclusivo); null = activo indefinidamente
  // Formato "YYYY-MM"
  deletedFrom String?

  // frequency: periodicidad del fijo, en meses (P1 — entero 1..12).
  // Rango lógico 1..12 (validado en el DTO; sin CHECK constraint en DB).
  // Anclada al startMonth: monthDiff(startMonth, mes) % frequency === 0
  // determina si el fijo aparece en ese mes. 1 = mensual, 12 = anual, etc.
  // Inmutable tras crearse (RF-MF-006): solo se define al alta.
  frequency Int @default(1)

  // Multi-moneda (Fase 1.2.3 / 1.2.4):
  // La cotización es POR MES DE APARICIÓN: cuando el usuario edita con split, la fila
  // nueva R2 hereda currency, exchangeRate y anchorCurrency del original (junto con los demás).
  // Los calculados heredan moneda, cotización y anchor del origen (no los persisten propios).
  // currency: default ARS para back-compat.
  // exchangeRate: cotización (unidades de anchorCurrency por 1 unidad de currency). Default 1.
  // anchorCurrency: moneda default del usuario al guardar. Default ARS para back-compat.
  currency        Currency @default(ARS)
  exchangeRate    Decimal  @default(1) @db.Decimal(18, 6)
  anchorCurrency  Currency @default(ARS)

  // autoDebit: débito automático (P4 — corrección de alcance). Atributo del MOVIMIENTO,
  // no del método de pago. Solo relevante para fijos NORMALES con paymentMethodId de
  // tipo DEBIT; un calculado NUNCA lo persiste (hereda del origen al vuelo, igual que
  // el método de pago y currency/exchangeRate). Nullable, default null.
  autoDebit Boolean?

  // ---------------------------------------------------------------------------
  // Identidad de cadena estable (Fase 1.1.7)
  // chainId: identificador que persiste a través de todos los splits del fijo.
  // Cuando PATCH hace un split (cierra R1 y abre R2), R2 hereda el chainId de R1.
  // Así el vínculo de los calculados al origen no se rompe al editar el origen.
  // Asignado en creación (cuid()) y nunca modificado después.
  // No es un FK — es un tag compartido por la cadena lógica.
  // ---------------------------------------------------------------------------
  chainId String @default(cuid())

  // ---------------------------------------------------------------------------
  // Movimiento calculado (Fase 1.1.7) — campos opcionales:
  // Solo presentes si esta fila ES un calculado (sourceChainId != null,
  // o sourceMovementId != null, o sourceInstallmentGroupId != null).
  // Un fijo normal deja todos estos campos en null.
  //
  // Invariante: exactamente uno de {sourceChainId, sourceMovementId,
  // sourceInstallmentGroupId} no-null en un calculado; los tres null = fijo normal.
  // La exclusión mutua se valida en el service (no hay CHECK constraint en DB).
  // ---------------------------------------------------------------------------

  // sourceChainId: chainId del fijo de origen (calculado de fijo).
  // FK lógica — no hay FK de DB (la cadena puede tener varias filas con distintos ids).
  sourceChainId String?

  // sourceMovementId: id del Transaction de origen (calculado de único — Fase 1.1.7.ext).
  // FK real con onDelete: Cascade — al borrar el Transaction, el calculado se borra solo.
  sourceMovementId String?

  // sourceInstallmentGroupId: id del InstallmentGroup de origen (calculado de cuota — Fase 1.1.7.ext).
  // FK real con onDelete: Cascade — al borrar el InstallmentGroup, el calculado se borra solo.
  sourceInstallmentGroupId String?

  // formulaOperator: operador de la fórmula (ADD/SUB/MUL/DIV/PCT).
  formulaOperator FormulaOperator?

  // formulaOperand: operando de la fórmula.
  // Para ADD/SUB: centavos (Int × 100). Para MUL/DIV: factor crudo × 1000000 (6 decimales).
  // Para PCT: porcentaje × 100 (ej. 10% → 1000, 1.5% → 150).
  // Se almacena como Int para precisión entera.
  formulaOperand Int?

  // formulaSign: signo del resultado. 1 = positivo, -1 = negativo.
  formulaSign Int?

  // Borrado lógico (RF-HIST-006): != null → esta fila fue eliminada (fijo normal o
  // calculado, de cualquier origen). Ortogonal a deletedFrom: deletedFrom es el
  // boundary "por mes" de un fijo vivo (RF-MF-004); deletedAt es "esta fila entera
  // no existe más" (reversible desde /historial hasta que se purgue — RF-HIST-005).
  // Una fila con deletedAt != null se excluye de TODA lectura de negocio.
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  category      Category       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  paymentMethod PaymentMethod? @relation(fields: [paymentMethodId], references: [id], onDelete: Restrict)

  // FK a Transaction de origen (calculado de único). onDelete: Cascade (solo aplica
  // en el borrado físico definitivo del reaper — RF-HIST-005).
  sourceMovement    Transaction?      @relation(fields: [sourceMovementId], references: [id], onDelete: Cascade)
  // FK a InstallmentGroup de origen (calculado de cuota). onDelete: Cascade.
  sourceInstallmentGroup InstallmentGroup? @relation(fields: [sourceInstallmentGroupId], references: [id], onDelete: Cascade)

  // Meses salteados (P1 — Fase 1.1.1): cada fila representa una aparición anulada.
  // onDelete: Cascade: si se borra el fijo, sus skips desaparecen.
  skips RecurringSkip[]

  @@index([userId])
  @@index([chainId])
  @@index([sourceChainId])
  @@index([sourceMovementId])
  @@index([sourceInstallmentGroupId])
}

// ---------------------------------------------------------------------------
// RecurringSkip (meses salteados por fijo — P1, Fase 1.1.1)
// ---------------------------------------------------------------------------

// Modela "una aparición del fijo está anulada para ese mes puntual".
// Es reversible: la acción es un toggle (anular / des-anular).
// El mes anulado SE SIGUE MOSTRANDO en /movements marcado con skipped=true.
// No suma a los totales del mes (se excluye del cálculo).
// Solo tiene sentido para meses en los que el fijo efectivamente aparece según su frecuencia.
model RecurringSkip {
  id          String @id @default(cuid())
  recurringId String
  // month: mes anulado en formato "YYYY-MM"
  month       String

  createdAt DateTime @default(now())

  recurring Recurring @relation(fields: [recurringId], references: [id], onDelete: Cascade)

  // Restricción: solo puede haber un skip por (fijo, mes)
  @@unique([recurringId, month])
  @@index([recurringId])
}

// ---------------------------------------------------------------------------
// CurrencyQuote — variantes de cotización FX (P7a — Fase 1.2.5)
// ---------------------------------------------------------------------------

// Histórico crudo de variantes de cotización FX capturadas de fuentes externas.
// Desacoplada de ReferenceRate: esta tabla guarda TODAS las variantes publicadas
// (oficial, blue, etc.); ReferenceRate guarda la que usa la conversión interna (oficial).
//
// variant: string libre (NO enum) — allowlist de variantes conocidas ("oficial", "blue")
// en el código del sync, sin constraint de DB. Agregar variante = editar la allowlist.
//
// compra/venta: unidades de la moneda por 1 USD (mismo pivote que ReferenceRate).
// Para fuentes con valor único (Frankfurter), compra == venta.
//
// Clave única: (currency, variant, yearMonth) — upsert idempotente.
// Índice: (currency, yearMonth) para listar variantes de un mes.
model CurrencyQuote {
  id         String   @id @default(cuid())
  currency   Currency
  variant    String   // string libre: "oficial", "blue", etc. Allowlist en código
  yearMonth  String   // "YYYY-MM"
  compra     Decimal  @db.Decimal(18, 6)
  venta      Decimal  @db.Decimal(18, 6)
  source     String   // host de origen
  fetchedAt  DateTime @db.Timestamptz

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([currency, variant, yearMonth])
  @@index([currency, yearMonth])
}

// ---------------------------------------------------------------------------
// InflationRate — IPC argentino (P7b — Fase 1.2.5)
// ---------------------------------------------------------------------------

// IPC nacional (INDEC) por mes. Se almacena ahora; ningún reporte lo consume aún.
// Fuente: apis.datos.gob.ar (series de tiempo INDEC).
// Clave única: yearMonth (un único valor de IPC por mes).
model InflationRate {
  id               String   @id @default(cuid())
  yearMonth        String   @unique // "YYYY-MM"
  monthlyVariation Decimal  @db.Decimal(18, 6) // variación mensual en puntos porcentuales
  indexValue       Decimal  @db.Decimal(18, 6) // nivel del índice IPC
  source           String   // host de origen
  fetchedAt        DateTime @db.Timestamptz

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// RateSyncLog — auditoría de la sincronización (P7 — Fase 1.2.5)
// ---------------------------------------------------------------------------

// Una fila por intento de escritura (aceptado o rechazado), para auditar la ingesta.
// El secret NUNCA se loguea en ningún campo.
model RateSyncLog {
  id         String   @id @default(cuid())
  source     String   // host consultado
  target     String   // qué se intentó escribir, ej. "CurrencyQuote:ARS:oficial:2026-06"
  rawPayload Json     // respuesta cruda de la fuente (sin el secret)
  accepted   Boolean  // true si pasó validación y se escribió
  reason     String?  // motivo del rechazo; null si accepted = true
  createdAt  DateTime @default(now())
}

// ---------------------------------------------------------------------------
// InstallmentGroup (grupo de cuotas)
// ---------------------------------------------------------------------------

model InstallmentGroup {
  id                String       @id @default(cuid())
  userId            String
  categoryId        String
  // paymentMethodId: método de pago asociado, opcional (RF-PM-006). Único para todo el
  // grupo (no hay split en cuotas). onDelete: Restrict, espejo de categoryId.
  paymentMethodId   String?
  type              MovementType
  // amountCents: monto POR CUOTA (no el total de la compra)
  amountCents       Int
  totalInstallments Int
  description       String?

  // startMonth: mes de la primera cuota, formato "YYYY-MM"
  startMonth String

  // Multi-moneda (Fase 1.2.3 / 1.2.4):
  // currency, exchangeRate y anchorCurrency son ÚNICOS para todo el grupo.
  // No hay split en cuotas: PATCH edita el grupo in-place (incluyendo moneda/cotización/anchor).
  // currency: default ARS para back-compat.
  // exchangeRate: cotización (unidades de anchorCurrency por 1 unidad de currency). Default 1.
  // anchorCurrency: moneda default del usuario al guardar. Default ARS para back-compat.
  currency        Currency @default(ARS)
  exchangeRate    Decimal  @default(1) @db.Decimal(18, 6)
  anchorCurrency  Currency @default(ARS)

  // autoDebit: débito automático (P4 — corrección de alcance). Atributo del MOVIMIENTO,
  // no del método de pago. Único para todo el grupo (no hay split en cuotas). Solo
  // relevante si paymentMethodId apunta a un método de tipo DEBIT. Nullable, default null.
  autoDebit Boolean?

  // Borrado lógico (RF-HIST-006): != null → el grupo de cuotas fue eliminado.
  // Deja de aparecer en TODA la app (todas las instancias, pasadas y futuras) salvo
  // /historial, desde donde es reversible (RF-HIST-003) mientras su entrada esté
  // vigente. El borrado físico ocurre recién al purgarse esa entrada (RF-HIST-005).
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  category      Category       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  paymentMethod PaymentMethod? @relation(fields: [paymentMethodId], references: [id], onDelete: Restrict)

  // Calculados derivados de este InstallmentGroup (Fase 1.1.7.ext).
  // onDelete: Cascade en la FK del lado Recurring: solo aplica en el borrado FÍSICO
  // definitivo (reaper de RF-HIST-005). Mientras el grupo está soft-deleted, la
  // cascada a sus calculados es lógica (RN-024/026), aplicada en RecurringService.
  calculados Recurring[]

  // Meses salteados (P3 — Fase 1.1.1.ext): cada fila anula UNA instancia (mes) del grupo,
  // no el grupo entero. Espejo exacto de RecurringSkip.
  // onDelete: Cascade: si se borra el grupo, sus skips desaparecen.
  skips InstallmentSkip[]

  @@index([userId])
}

// ---------------------------------------------------------------------------
// InstallmentSkip (meses salteados por grupo de cuotas — P3, Fase 1.1.1.ext)
// ---------------------------------------------------------------------------

// Modela "una cuota puntual de un grupo está anulada para ese mes puntual".
// Es reversible: la acción es un toggle (anular / des-anular).
// El mes anulado SE SIGUE MOSTRANDO en /movements marcado con skipped=true.
// No suma a los totales del mes ni a ningún reporte (se excluye del cálculo).
// Espejo exacto de RecurringSkip (ver arriba).
model InstallmentSkip {
  id                  String @id @default(cuid())
  installmentGroupId  String
  // month: mes anulado en formato "YYYY-MM"
  month               String

  createdAt DateTime @default(now())

  installmentGroup InstallmentGroup @relation(fields: [installmentGroupId], references: [id], onDelete: Cascade)

  // Restricción: solo puede haber un skip por (grupo, mes)
  @@unique([installmentGroupId, month])
  @@index([installmentGroupId])
}

// ---------------------------------------------------------------------------
// Simulation (simulación de categoría — Módulo 3.15, RF-SIM-001..004)
// ---------------------------------------------------------------------------

// Persiste SOLO la configuración (usuario + categoría) — RN-029: ni monto, ni
// dirección, ni horizonte se guardan; todo se deriva on-the-fly en cada lectura
// (RF-SIM-002, motor en common/projection.helper.ts). No hay filas de movimiento
// asociadas: los "movimientos simulados" se sintetizan en GET /movements con un
// id derivado (nunca persistido) — ver SimulationsService.
//
// A lo sumo una simulación por (userId, categoryId) — RF-SIM-001: "como máximo
// una por categoría". Impuesto en la DB con un índice único común.
//
// Borrado FÍSICO (RF-SIM-004): esta especie NO participa del historial de
// cambios ni es deshacible — DELETE /simulations/:id borra la fila directamente.
model Simulation {
  id         String @id @default(cuid())
  userId     String
  categoryId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // onDelete: Restrict — espejo de categoryId en Transaction/Recurring/InstallmentGroup:
  // impide borrar físicamente una categoría con una simulación que la referencia.
  category Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@unique([userId, categoryId])
  @@index([userId])
  @@index([categoryId])
}
