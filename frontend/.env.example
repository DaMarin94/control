# =============================================
# CONTROL - Frontend - Variables de entorno
# =============================================
# Copiar este archivo como .env.local y completar los valores reales.
# NUNCA commitear .env.local ni ningún archivo con valores reales.

# --- Backend ---
# URL base del backend NestJS (pública, usada en el browser para las llamadas a la API)
NEXT_PUBLIC_API_URL=

# --- Auth.js (NextAuth v5) ---
# Secret para firmar/encriptar la sesión de Auth.js (generá con: openssl rand -base64 32)
AUTH_SECRET=

# JWT firmado para el backend (HS256, secret compartido entre front y back)
# Mismo valor que el secret configurado en el backend para validar el JWT
AUTH_BACKEND_JWT_SECRET=

# --- Google OAuth ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- URLs ---
# URL pública del frontend (necesaria para callbacks de OAuth en producción)
NEXTAUTH_URL=http://localhost:3000
