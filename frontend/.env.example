# =============================================
# CONTROL - Frontend - Variables de entorno
# =============================================
# Copiar este archivo como .env.local y completar los valores reales.
# NUNCA commitear .env.local ni ningún archivo con valores reales.

# --- Backend ---
# URL base del backend NestJS (pública, usada en el browser para las llamadas a la API)
NEXT_PUBLIC_API_URL=

# --- Auth.js (NextAuth v5) ---
# Secret para firmar/encriptar la sesión de Auth.js (generá con: openssl rand -base64 32)
# Debe tener al menos 32 caracteres.
AUTH_SECRET=

# --- Google OAuth (opcional — scaffolded, pendiente de credenciales reales) ---
# Dejar vacías para deshabilitar Google sin romper el arranque.
# Cuando se configure, el botón "Continuar con Google" se activa automáticamente.
# Obtener en: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- URLs ---
# URL pública del frontend (necesaria para callbacks de OAuth en producción)
NEXTAUTH_URL=http://localhost:3000
